{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gili",
  "version": "4.1.1",
  "identifier": "com.faiz.notch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gili",
        "width": 1040,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "resizable": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFQTM5RjFERDM3QUVDMjEKUldRaDdIclRIWitqdnUwQjE0aGtsWTVZOVVpQlZmcFYvVy9Ld3JScmFuVXpnN2dHYnJPVjVLQkMK",
      "endpoints": [
        "https://github.com/fyznugraha-pixel/notch-island/releases/latest/download/latest.json"
      ]
    }
  }
}
