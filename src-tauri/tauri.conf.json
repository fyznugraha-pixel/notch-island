{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Gili",
    "version":  "4.2.5",
    "identifier":  "com.faiz.notch",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1421",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Gili",
                                    "width":  1200,
                                    "height":  760,
                                    "transparent":  true,
                                    "decorations":  false,
                                    "shadow":  false,
                                    "alwaysOnTop":  true,
                                    "skipTaskbar":  true,
                                    "visible":  true,
                                    "resizable":  false,
                                    "additionalBrowserArgs":  "--autoplay-policy=no-user-gesture-required --enable-gpu-rasterization --enable-zero-copy --disable-features=CalculateNativeWinOcclusion"
                                }
                            ],
                "security":  {
                                 "csp":  {
                                             "default-src":  "\u0027self\u0027",
                                             "script-src":  "\u0027self\u0027",
                                             "style-src":  "\u0027self\u0027 \u0027unsafe-inline\u0027",
                                             "font-src":  "\u0027self\u0027 data:",
                                             "img-src":  "\u0027self\u0027 data: blob: https:",
                                             "media-src":  "\u0027self\u0027 blob: http: https:",
                                             "connect-src":  "\u0027self\u0027 ipc: http://ipc.localhost http: https:",
                                             "object-src":  "\u0027none\u0027",
                                             "frame-src":  "\u0027none\u0027",
                                             "base-uri":  "\u0027self\u0027",
                                             "form-action":  "\u0027none\u0027"
                                         }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installerIcon":  "icons/icon.ico"
                                            },
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper"
                                                          }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFQTM5RjFERDM3QUVDMjEKUldRaDdIclRIWitqdnUwQjE0aGtsWTVZOVVpQlZmcFYvVy9Ld3JScmFuVXpnN2dHYnJPVjVLQkMK",
                                    "endpoints":  [
                                                      "https://github.com/fyznugraha-pixel/notch-island/releases/latest/download/latest.json"
                                                  ]
                                }
                }
}
